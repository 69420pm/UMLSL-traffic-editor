  <property name="styleSheet">
   <string notr="true">/* --- THE CONTAINER (The Row Item) --- */
/* We assume the root widget of your .ui file is named 'ListItemFrame' */
QWidget#ListItemFrame {
    background-color: #0b1d29; /* Dark Blue-Grey Background */
    border-radius: 18px;       /* Heavily rounded corners */
    border: 2px solid transparent; /* Invisible border by default to prevent sizing jumps */
}

/* --- THE SELECTED STATE --- */
/* We will toggle a property called &quot;selected&quot; in code to trigger this */
QWidget#ListItemFrame[selected=&quot;true&quot;] {
    border: 2px solid #ffffff; /* The White Outline */
    background-color: #0b1d29; /* Ensure bg stays same */
}

/* --- LABELS --- */
QLabel {
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;Roboto&quot;, sans-serif;
    font-size: 14px;
    border: none;
    background: transparent;
}

/* The ID Label (C1, C2...) - Bold and Larger */
QLabel#idLabel {
    font-weight: 900;
    font-size: 18px;
    margin-left: 10px;
}

/* The Value Label (x = -3) - Monospace-ish look usually looks good here */
QLabel#valueLabel {
    font-weight: bold;
}

/* --- THE EDIT BUTTON --- */
QPushButton#editBtn {
    background-color: #163042; /* Slightly lighter/different tone than background */
    border-radius: 18px;       /* Half of height (assuming 36px height) */
    border: none;
    color: white;
    font-size: 14px;
    /* You would set the pencil icon via setIcon() in code or Designer */
}

QPushButton#editBtn:hover {
    background-color: #1f425a; /* Lighter on hover */
}

QPushButton#editBtn:pressed {
    background-color: #0d1e2b;
}</string>
